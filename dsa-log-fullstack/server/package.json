{
  "name": "dsa-log-server",
  "version": "1.0.0",
  "description": "DSA Log full stack server: REST API plus static front end",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "node --test tests/*.test.js",
    "check": "node scripts/check.js",
    "profile": "node scripts/profile.js",
    "test:unit": "node --test tests/unit.test.js tests/frontend-api.test.js tests/static-structure.test.js",
    "test:integration": "node --test tests/api.test.js tests/static.test.js",
    "smoke": "node scripts/smoke-test.js",
    "backup": "node scripts/backup.js",
    "audit:prod": "npm audit --omit=dev"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^13.0.3",
    "cors": "^2.8.6",
    "dotenv": "^18.0.5",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "supertest": "^7.3.0"
  },
  "engines": {
    "node": ">=22"
  }
}
