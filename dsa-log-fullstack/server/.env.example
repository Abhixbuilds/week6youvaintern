# ---- Local development: copy this file to .env and edit ----
PORT=3000
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=1h
DB_PATH=./data/dsa-log.db
BCRYPT_ROUNDS=10
# CORS is only needed if a different domain calls the API. Same-origin (default) needs none.
# CORS_ORIGIN=*
# CLIENT_DIR=../client

# ---- Production (set these in the hosting dashboard, NOT in a committed file) ----
# NODE_ENV=production            enables production checks (JWT_SECRET required, at least 32 characters)
# JWT_SECRET=<64 random hex characters>   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# DB_PATH=/var/data/dsa-log.db   a path on a PERSISTENT disk (the default folder is wiped on free plans)
# TRUST_PROXY=1                  number of proxies in front of the app (default 1 in production)
# LOG_REQUESTS=true              one JSON log line per request (default true in production)
